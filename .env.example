# Copie este archivo como .env y llene los valores.
JWT_SECRET=cambie_esto_por_una_clave_larga
DATABASE_URL=postgresql://usuario:clave@host:5432/postgres
# Solo se usa la primera vez, con la base vacía, para crear el usuario admin.
ADMIN_INICIAL_PASSWORD=
# produccion -> cookie solo por HTTPS
ENTORNO=
# Demo público (opcional)
DEMO_NIT=
DEMO_USER=
DEMO_PASS=
# Panel del dueño (opcional)
ADMIN_MASTER_KEY=
